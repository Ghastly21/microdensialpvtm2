<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MikroVolt | Belajar Kendaraan Listrik dalam Modul Singkat</title>
<meta name="description" content="Microlearning kendaraan listrik: modul singkat, diagram interaktif, kalkulator, dan kuis dengan referensi dari sumber terpercaya.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;700;800&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --navy:#0b2a4a; --navy-2:#13426f; --gold:#e8a317; --green:#12a37f;
  --bg:#f3f6fa; --card:#ffffff; --ink:#1b2733; --muted:#5b6b7b; --line:#dbe3ec;
  --radius:14px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:76px}
body{font-family:"Source Sans 3",system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ink);background:var(--bg);line-height:1.65;font-size:17px}
h1,h2,h3,h4{font-family:Sora,"Segoe UI",system-ui,sans-serif;line-height:1.25;color:var(--navy)}
a{color:var(--navy-2)}
:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
.wrap{max-width:1160px;margin:0 auto;padding:0 20px}
.skip{position:absolute;left:-999px;top:0;background:var(--gold);color:#000;padding:8px 14px;z-index:100}
.skip:focus{left:10px;top:10px}

/* top bar + nav (meniru susunan eLOK) */
.topbar{background:var(--navy);color:#cfe0f2;font-size:14px}
.topbar .wrap{display:flex;gap:22px;padding-top:7px;padding-bottom:7px;flex-wrap:wrap}
.topbar a{color:#cfe0f2;text-decoration:none}
.topbar a:hover{color:#fff}
header.nav{position:sticky;top:0;z-index:50;background:#fff;border-bottom:1px solid var(--line)}
header.nav .wrap{display:flex;align-items:center;justify-content:space-between;height:68px}
.logo{display:flex;align-items:center;gap:10px;font-family:Sora,sans-serif;font-weight:800;font-size:22px;color:var(--navy);text-decoration:none}
.logo svg{width:34px;height:34px}
.logo b{color:var(--green)}
nav ul{display:flex;gap:6px;list-style:none}
nav a{display:block;padding:8px 14px;border-radius:8px;text-decoration:none;color:var(--ink);font-weight:600;font-size:16px}
nav a:hover,nav a.on{background:var(--bg);color:var(--navy)}
.burger{display:none;background:none;border:1px solid var(--line);border-radius:8px;padding:8px 12px;font-size:18px;cursor:pointer}
.btn{display:inline-block;background:var(--gold);color:#241800;font-weight:700;padding:12px 22px;border-radius:999px;text-decoration:none;border:0;cursor:pointer;font-size:16px;font-family:inherit}
.btn:hover{filter:brightness(1.07)}
.btn.ghost{background:transparent;color:#fff;border:2px solid rgba(255,255,255,.55)}
.btn.sm{padding:8px 16px;font-size:15px}

/* hero slider */
.hero{background:linear-gradient(120deg,var(--navy),var(--navy-2));color:#fff;position:relative;overflow:hidden}
.slides{position:relative;min-height:470px}
.slide{position:absolute;inset:0;display:grid;grid-template-columns:1.05fr 1fr;gap:30px;align-items:center;opacity:0;visibility:hidden;transition:opacity .7s}
.slide.on{opacity:1;visibility:visible}
.slide .wrap{display:contents}
.slide .txt{padding-left:max(20px,calc((100vw - 1160px)/2 + 20px))}
.slide .art{padding-right:max(20px,calc((100vw - 1160px)/2 + 20px))}
.slide h1,.slide h2{color:#fff;font-size:clamp(28px,4vw,46px);margin-bottom:14px}
.slide p{color:#cfe0f2;max-width:520px;margin-bottom:24px;font-size:18px}
.slide .cta{display:flex;gap:12px;flex-wrap:wrap}
.hero-ctrl{position:absolute;bottom:18px;left:0;right:0;display:flex;justify-content:center;align-items:center;gap:14px}
.dot{width:11px;height:11px;border-radius:50%;border:0;background:rgba(255,255,255,.35);cursor:pointer}
.dot.on{background:var(--gold);width:30px;border-radius:8px}
.arrow{background:rgba(255,255,255,.12);border:0;color:#fff;width:36px;height:36px;border-radius:50%;cursor:pointer;font-size:18px}
.arrow:hover{background:rgba(255,255,255,.25)}

/* animasi mobil */
.road{stroke:#6f8fb0;stroke-width:3;stroke-dasharray:26 22;animation:road 1s linear infinite}
@keyframes road{to{stroke-dashoffset:-48}}
.wheel{transform-box:fill-box;transform-origin:center;animation:spin 1.1s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.car{animation:bob 1.6s ease-in-out infinite}
@keyframes bob{50%{transform:translateY(-3px)}}
.bolt{animation:pulse 1.4s ease-in-out infinite;transform-box:fill-box;transform-origin:center}
@keyframes pulse{50%{opacity:.35;transform:scale(.88)}}
.fill{animation:fill 3.2s ease-in-out infinite}
@keyframes fill{0%{transform:scaleY(.1)}80%,100%{transform:scaleY(1)}}
.fill{transform-box:fill-box;transform-origin:bottom}

.stats{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.stat{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);border-radius:var(--radius);padding:18px}
.stat strong{display:block;font-family:Sora,sans-serif;font-size:34px;color:var(--gold)}
.stat span{font-size:15px;color:#d8e6f5}

/* sections */
section{padding:64px 0}
.sec-h{margin-bottom:30px;max-width:720px}
.sec-h h2{font-size:clamp(24px,3vw,34px);margin-bottom:8px}
.sec-h p{color:var(--muted)}
.alt{background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}

.progress{display:flex;align-items:center;gap:14px;margin-bottom:22px;background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:14px 18px}
.bar{flex:1;height:10px;background:var(--bg);border-radius:8px;overflow:hidden}
.bar i{display:block;height:100%;width:0;background:var(--green);transition:width .5s}

.mods{display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:20px}
.mod{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);display:flex;flex-direction:column;overflow:hidden}
.mod-head{display:flex;gap:14px;padding:20px 20px 8px}
.ico{flex:none;width:48px;height:48px;border-radius:12px;background:var(--bg);display:grid;place-items:center;font-size:24px}
.mod.done .ico{background:#d8f3ea}
.mod h3{font-size:18px}
.meta{font-size:14px;color:var(--muted)}
.mod p.sum{padding:0 20px;color:var(--muted)}
.mod .body{display:none;padding:12px 20px 0}
.mod.open .body{display:block}
.mod .body ul{padding-left:20px;margin-bottom:10px}
.mod .body li{margin-bottom:6px}
.src{font-size:14px}
.mod-foot{margin-top:auto;display:flex;gap:10px;padding:16px 20px;flex-wrap:wrap}
.btn-o{background:#fff;border:2px solid var(--navy);color:var(--navy);font-weight:700;border-radius:999px;padding:7px 16px;cursor:pointer;font-family:inherit;font-size:15px}
.btn-o:hover{background:var(--navy);color:#fff}
.btn-o.ok{border-color:var(--green);color:var(--green)}
.btn-o.ok.on{background:var(--green);color:#fff}

/* diagram */
.diag{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:24px}
.tog{display:inline-flex;border:2px solid var(--navy);border-radius:999px;overflow:hidden;margin-bottom:20px}
.tog button{border:0;background:#fff;padding:8px 18px;font-weight:700;cursor:pointer;font-family:inherit;font-size:15px;color:var(--navy)}
.tog button.on{background:var(--navy);color:#fff}
.flow{display:flex;align-items:center;gap:0;flex-wrap:wrap;justify-content:center}
.node{background:var(--bg);border:2px solid var(--line);border-radius:12px;padding:12px 14px;text-align:center;cursor:pointer;min-width:112px;font-family:inherit;font-size:15px;font-weight:600;color:var(--ink)}
.node span{display:block;font-size:26px}
.node:hover{border-color:var(--navy-2)}
.node.on{border-color:var(--gold);background:#fff7e0}
.link{width:54px;height:6px;background:repeating-linear-gradient(90deg,var(--green) 0 10px,transparent 10px 20px);background-size:20px 6px;animation:flow .8s linear infinite;border-radius:3px;margin:0 4px}
@keyframes flow{to{background-position:20px 0}}
.regen .link{animation-direction:reverse;background:repeating-linear-gradient(90deg,var(--gold) 0 10px,transparent 10px 20px)}
.info{margin-top:22px;background:var(--bg);border-left:5px solid var(--gold);border-radius:8px;padding:16px 18px}
.info h4{margin-bottom:4px}

/* kalkulator */
.calc{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.panel{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:22px}
label{display:block;font-weight:600;margin-top:12px;font-size:15px}
input[type=number]{width:100%;padding:10px 12px;border:1px solid var(--line);border-radius:8px;font-size:16px;font-family:inherit;margin-top:4px}
.res{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:6px}
.res div{background:var(--bg);border-radius:10px;padding:14px}
.res b{display:block;font-family:Sora,sans-serif;font-size:24px;color:var(--navy)}
.res small{color:var(--muted)}
.note{font-size:14px;color:var(--muted);margin-top:14px}

/* kuis */
.quiz{max-width:760px}
.q{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:22px}
.q h3{font-size:19px;margin-bottom:14px}
.opt{display:block;width:100%;text-align:left;background:#fff;border:2px solid var(--line);border-radius:10px;padding:12px 14px;margin-bottom:10px;cursor:pointer;font-family:inherit;font-size:16px;color:var(--ink)}
.opt:hover:not(:disabled){border-color:var(--navy-2)}
.opt.right{border-color:var(--green);background:#e6f7f1}
.opt.wrong{border-color:#d64545;background:#fdeaea}
.fb{margin:6px 0 14px;font-size:15px}
.qnav{display:flex;justify-content:space-between;align-items:center;margin-top:8px}

/* about */
.about{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px}
.about div{background:var(--bg);border-radius:var(--radius);padding:22px}
.about .ico{margin-bottom:10px;background:#fff}
.refs{columns:2;column-gap:30px;list-style:none}
.refs li{break-inside:avoid;margin-bottom:12px;padding-left:2px}
.refs small{color:var(--muted);display:block}

footer{background:var(--navy);color:#cfe0f2;padding:44px 0 24px;font-size:15px}
footer .cols{display:grid;grid-template-columns:1.4fr 1fr;gap:30px;margin-bottom:24px}
footer h4{color:#fff;margin-bottom:8px;font-size:15px;letter-spacing:.04em}
footer a{color:#cfe0f2}
footer .copy{border-top:1px solid rgba(255,255,255,.15);padding-top:16px;font-size:14px}

@media(max-width:860px){
  .burger{display:block}
  nav{position:absolute;top:68px;left:0;right:0;background:#fff;border-bottom:1px solid var(--line);display:none}
  nav.open{display:block}
  nav ul{flex-direction:column;padding:10px 20px}
  .slides{min-height:640px}
  .slide{grid-template-columns:1fr;align-content:center;gap:10px}
  .slide .art{padding-top:0;max-height:210px;overflow:hidden}
  .slide .txt{padding-top:20px}
  .calc,footer .cols{grid-template-columns:1fr}
  .refs{columns:1}
  .link{width:6px;height:26px;margin:4px 0;background:repeating-linear-gradient(180deg,var(--green) 0 8px,transparent 8px 16px);background-size:6px 16px}
  .flow{flex-direction:column}
}
@media(prefers-reduced-motion:reduce){
  *{animation:none!important;transition:none!important}
  html{scroll-behavior:auto}
}
</style>
</head>
<body>
<a class="skip" href="#modul">Lewati ke konten</a>

<div class="topbar"><div class="wrap">
  <a href="#modul">Modul</a><a href="#referensi">Referensi</a><a href="#kuis">Kuis</a>
</div></div>

<header class="nav"><div class="wrap">
  <a class="logo" href="#top" aria-label="MikroVolt beranda">
    <svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="19" fill="#0b2a4a"/><path d="M22 6 10 23h8l-2 11 14-18h-9z" fill="#e8a317"/></svg>
    Mikro<b>Volt</b>
  </a>
  <button class="burger" id="burger" aria-label="Buka menu" aria-expanded="false">☰</button>
  <nav id="nav" aria-label="Navigasi utama">
    <ul>
      <li><a href="#top" class="on">Home</a></li>
      <li><a href="#modul">Modul</a></li>
      <li><a href="#diagram">Cara Kerja</a></li>
      <li><a href="#kalkulator">Kalkulator</a></li>
      <li><a href="#kuis">Kuis</a></li>
      <li><a href="#referensi">Referensi</a></li>
    </ul>
  </nav>
</div></header>

<main id="top">
<!-- HERO SLIDER -->
<div class="hero" aria-roledescription="carousel" aria-label="Sorotan">
  <div class="slides" id="slides">

    <div class="slide on">
      <div class="wrap">
        <div class="txt">
          <h1>Kendaraan listrik, dipelajari dalam modul singkat</h1>
          <p>Enam modul, masing-masing sekitar tiga menit. Pelajari komponen, baterai, pengisian daya, dan konversi motor, lalu uji pemahamanmu lewat kuis.</p>
          <div class="cta"><a class="btn" href="#modul">Mulai belajar</a><a class="btn ghost" href="#diagram">Lihat cara kerjanya</a></div>
        </div>
        <div class="art">
          <svg viewBox="0 0 420 240" role="img" aria-label="Ilustrasi mobil listrik melaju">
            <line class="road" x1="0" y1="205" x2="420" y2="205"/>
            <g class="car">
              <path d="M40 170 L52 135 Q58 122 74 120 L140 118 L170 88 Q178 80 192 80 L262 80 Q278 80 288 92 L318 118 L368 124 Q384 128 384 144 L384 170 Z" fill="#e8a317"/>
              <path d="M150 118 L176 94 Q180 90 188 90 L226 90 L226 118 Z" fill="#cfe9ff"/>
              <path d="M236 90 L264 90 Q272 90 278 97 L300 118 L236 118 Z" fill="#cfe9ff"/>
              <path class="bolt" d="M214 142 198 160h10l-4 14 18-20h-10z" fill="#0b2a4a"/>
              <g><circle cx="108" cy="172" r="26" fill="#14202b"/><g class="wheel"><circle cx="108" cy="172" r="15" fill="#c9d5e2"/><path d="M108 158v28M94 172h28" stroke="#14202b" stroke-width="4"/></g></g>
              <g><circle cx="318" cy="172" r="26" fill="#14202b"/><g class="wheel"><circle cx="318" cy="172" r="15" fill="#c9d5e2"/><path d="M318 158v28M304 172h28" stroke="#14202b" stroke-width="4"/></g></g>
            </g>
          </svg>
        </div>
      </div>
    </div>

    <div class="slide">
      <div class="wrap">
        <div class="txt">
          <h2>Penjualan mobil listrik dunia terus naik</h2>
          <p>Menurut IEA Global EV Outlook 2026, penjualan mobil listrik global pada 2025 naik 20% dan melampaui 20 juta unit. Asia Tenggara termasuk pasar dengan pertumbuhan tercepat.</p>
          <div class="cta"><a class="btn" href="#m6" data-open="m6">Baca modul dampak &amp; tren</a></div>
        </div>
        <div class="art">
          <div class="stats">
            <div class="stat"><strong><span class="count" data-to="20" data-suffix="+ juta">0</span></strong><span>mobil listrik terjual dunia, 2025</span></div>
            <div class="stat"><strong><span class="count" data-to="60" data-suffix="%">0</span></strong><span>pasokan dari produsen asal China</span></div>
            <div class="stat"><strong><span class="count" data-to="23" data-suffix=" juta">0</span></strong><span>proyeksi penjualan 2026</span></div>
            <div class="stat"><strong><span class="count" data-to="20" data-suffix="%">0</span></strong><span>pangsa EV di Asia Tenggara, hampir, 2025</span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="slide">
      <div class="wrap">
        <div class="txt">
          <h2>Dari bensin ke listrik: konversi motor di Indonesia</h2>
          <p>Pemerintah mendorong ekosistem KBLBB, termasuk konversi sepeda motor BBM menjadi motor listrik, stasiun pengisian (SPKLU), dan stasiun penukaran baterai (SPBKLU).</p>
          <div class="cta"><a class="btn" href="#m5" data-open="m5">Baca modul konversi motor</a></div>
        </div>
        <div class="art">
          <svg viewBox="0 0 420 240" role="img" aria-label="Ilustrasi stasiun pengisian dan baterai terisi">
            <rect x="60" y="40" width="130" height="170" rx="14" fill="#fff"/>
            <rect x="76" y="58" width="98" height="52" rx="6" fill="#0b2a4a"/>
            <path class="bolt" d="M130 66 108 92h16l-5 14 22-28h-16z" fill="#e8a317"/>
            <rect x="84" y="128" width="82" height="10" rx="5" fill="#dbe3ec"/>
            <rect x="84" y="150" width="56" height="10" rx="5" fill="#dbe3ec"/>
            <path d="M190 160 Q230 160 240 130 T290 110" fill="none" stroke="#e8a317" stroke-width="6" stroke-linecap="round"/>
            <rect x="286" y="96" width="28" height="30" rx="5" fill="#e8a317"/>
            <rect x="318" y="60" width="64" height="130" rx="10" fill="none" stroke="#fff" stroke-width="6"/>
            <rect x="338" y="48" width="24" height="12" rx="3" fill="#fff"/>
            <rect class="fill" x="326" y="68" width="48" height="114" rx="5" fill="#12a37f"/>
          </svg>
        </div>
      </div>
    </div>

  </div>
  <div class="hero-ctrl">
    <button class="arrow" id="prev" aria-label="Slide sebelumnya">‹</button>
    <span id="dots" style="display:flex;gap:8px"></span>
    <button class="arrow" id="next" aria-label="Slide berikutnya">›</button>
  </div>
</div>

<!-- MODUL -->
<section id="modul"><div class="wrap">
  <div class="sec-h">
    <h2>Modul belajar</h2>
    <p>Buka satu modul, baca poin-poinnya, lalu tandai selesai. Progresmu tersimpan di peramban ini.</p>
  </div>
  <div class="progress"><strong id="pText">0 / 6 selesai</strong><div class="bar"><i id="pBar"></i></div></div>
  <div class="mods" id="mods"></div>
</div></section>

<!-- DIAGRAM -->
<section id="diagram" class="alt"><div class="wrap">
  <div class="sec-h">
    <h2>Cara kerja penggerak listrik</h2>
    <p>Klik tiap komponen untuk melihat perannya. Ganti mode untuk melihat arah aliran energi saat mengerem.</p>
  </div>
  <div class="diag" id="diag">
    <div class="tog" role="group" aria-label="Mode aliran energi">
      <button class="on" data-mode="drive">Berjalan</button>
      <button data-mode="regen">Mengerem (regeneratif)</button>
    </div>
    <div class="flow" id="flow"></div>
    <div class="info" id="info" aria-live="polite"></div>
  </div>
</div></section>

<!-- KALKULATOR -->
<section id="kalkulator"><div class="wrap">
  <div class="sec-h">
    <h2>Kalkulator jarak tempuh dan biaya</h2>
    <p>Ubah angkanya sesuai kendaraan dan tarif di daerahmu. Nilai awal hanya contoh.</p>
  </div>
  <div class="calc">
    <div class="panel">
      <h3>Masukan</h3>
      <label for="v">Tegangan baterai (V)</label><input type="number" id="v" value="72" min="1">
      <label for="ah">Kapasitas baterai (Ah)</label><input type="number" id="ah" value="30" min="1">
      <label for="use">Kapasitas yang bisa dipakai (%)</label><input type="number" id="use" value="90" min="10" max="100">
      <label for="wh">Konsumsi energi (Wh per km)</label><input type="number" id="wh" value="30" min="1">
      <label for="chg">Daya charger (W)</label><input type="number" id="chg" value="500" min="50">
      <label for="tar">Tarif listrik (Rp per kWh)</label><input type="number" id="tar" value="1445" min="0">
      <label for="kmL">Konsumsi motor bensin pembanding (km per liter)</label><input type="number" id="kmL" value="40" min="1">
      <label for="fuel">Harga bensin (Rp per liter)</label><input type="number" id="fuel" value="10000" min="0">
    </div>
    <div class="panel">
      <h3>Hasil</h3>
      <div class="res">
        <div><b id="rE">-</b><small>energi baterai</small></div>
        <div><b id="rR">-</b><small>perkiraan jarak tempuh</small></div>
        <div><b id="rT">-</b><small>waktu isi penuh (kasar)</small></div>
        <div><b id="rC">-</b><small>biaya listrik per 100 km</small></div>
        <div style="grid-column:1/-1"><b id="rF">-</b><small>biaya bensin per 100 km (pembanding)</small></div>
      </div>
      <p class="note">Rumus: energi (kWh) = V × Ah ÷ 1000. Jarak = energi terpakai ÷ konsumsi. Hasil nyata dipengaruhi beban, medan, kecepatan, suhu, kondisi baterai, dan efisiensi charger.</p>
    </div>
  </div>
</div></section>

<!-- KUIS -->
<section id="kuis" class="alt"><div class="wrap">
  <div class="sec-h">
    <h2>Kuis singkat</h2>
    <p>Enam pertanyaan untuk menguji pemahamanmu dari seluruh modul.</p>
  </div>
  <div class="quiz" id="quiz"></div>
</div></section>

<!-- TENTANG & REFERENSI -->
<section id="referensi"><div class="wrap">
  <div class="sec-h">
    <h2>Tentang situs ini</h2>
    <p>Materi dirangkum dari lembaga resmi dan publikasi ilmiah. Untuk keputusan teknis atau pembelian, rujuk dokumen aslinya.</p>
  </div>
  <div class="about">
    <div><div class="ico">📚</div><h3>Modul singkat</h3><p>Satu ide per modul supaya mudah diselesaikan di sela kegiatan.</p></div>
    <div><div class="ico">🔧</div><h3>Interaktif</h3><p>Diagram komponen dan kalkulator membantu memahami angka-angkanya.</p></div>
    <div><div class="ico">✅</div><h3>Ada kuis</h3><p>Uji pemahaman langsung setelah membaca modul.</p></div>
    <div><div class="ico">🔎</div><h3>Bersumber</h3><p>Setiap modul mencantumkan sumber yang bisa kamu buka.</p></div>
  </div>
  <h3 style="margin:36px 0 14px">Daftar referensi</h3>
  <ul class="refs">
    <li><a href="https://www.iea.org/reports/global-ev-outlook-2026" target="_blank" rel="noopener">IEA, Global EV Outlook 2026</a><small>Data penjualan dan proyeksi global.</small></li>
    <li><a href="https://jdih.esdm.go.id/storage/document/PM%20ESDM%20No.%2013%20Tahun%202020.pdf" target="_blank" rel="noopener">Permen ESDM No. 13 Tahun 2020</a><small>Penyediaan infrastruktur pengisian listrik untuk KBLBB.</small></li>
    <li><a href="https://esdm.go.id/id/berita-unit/direktorat-jenderal-ketenagalistrikan/sosialisasikan-kendaraan-listrik-kementerian-esdm-dorong-partisipasi-pelaku-usaha" target="_blank" rel="noopener">Kementerian ESDM, Sosialisasi Kendaraan Listrik</a><small>Program KBLBB dan pilot konversi motor.</small></li>
    <li><a href="https://listrikindonesia.com/detail/11566/upaya-kementerian-esdm-dorong-ekosistem-kendaraan-listrik" target="_blank" rel="noopener">Listrik Indonesia, Upaya ESDM Dorong Ekosistem Kendaraan Listrik</a><small>Populasi roda dua dan pelatihan bengkel konversi.</small></li>
    <li><a href="https://listrikindonesia.com/detail/9799/kementerian-esdm-gandeng-pln-dan-pertamina-percepat-konversi-motor-bbm-ke-motor-listrik" target="_blank" rel="noopener">Listrik Indonesia, ESDM, PLN, dan Pertamina Percepat Konversi</a><small>SPKLU, SPBKLU, dan home charging.</small></li>
    <li><a href="https://industri.kontan.co.id/news/kementerian-esdm-gandeng-sejumlah-pihak-dorong-pengembangan-motor-listrik" target="_blank" rel="noopener">Kontan, Pengembangan Motor Listrik</a><small>Baterai LiNMC 72V 20Ah dan 72V 30Ah.</small></li>
    <li><a href="https://www.cnbcindonesia.com/news/20220810121454-4-362605/brumbrum-6-juta-motor-listrik-siap-mengaspal-di-ri" target="_blank" rel="noopener">CNBC Indonesia, 6 Juta Motor Listrik</a><small>Target pemerintah yang dicanangkan tahun 2022.</small></li>
    <li><a href="https://jurnal.politap.ac.id/index.php/entries/article/download/1509/1110/8920" target="_blank" rel="noopener">Jurnal Politeknik Negeri Tanah Laut, Sepeda Listrik BLDC</a><small>Komponen dan unjuk kerja kendaraan listrik.</small></li>
    <li><a href="https://electrek.co/2026/05/19/iea-global-ev-sales-headed-for-another-record-year-despite-the-slowdown/" target="_blank" rel="noopener">Electrek, ringkasan IEA Global EV Outlook 2026</a><small>Pangsa EV di Asia Tenggara.</small></li>
  </ul>
</div></section>
</main>

<footer><div class="wrap">
  <div class="cols">
    <div><h4>TENTANG</h4><p>MikroVolt adalah situs belajar mandiri tentang kendaraan listrik dengan format modul singkat. Tata letaknya terinspirasi dari tampilan eLOK UGM, dan situs ini bukan bagian resmi dari UGM.</p></div>
    <div><h4>PINTASAN</h4><p><a href="#modul">Modul</a><br><a href="#kalkulator">Kalkulator</a><br><a href="#kuis">Kuis</a><br><a href="#referensi">Referensi</a></p></div>
  </div>
  <div class="copy">© 2026 MikroVolt. Materi bersifat edukasi umum.</div>
</div></footer>

<script>
/* ---------- util ---------- */
const $ = (s, r=document) => r.querySelector(s);
const $$ = (s, r=document) => [...r.querySelectorAll(s)];
const store = {
  get(k, d){ try{ const v = localStorage.getItem(k); return v ? JSON.parse(v) : d; }catch(e){ return d; } },
  set(k, v){ try{ localStorage.setItem(k, JSON.stringify(v)); }catch(e){} }
};

/* ---------- nav ---------- */
$('#burger').addEventListener('click', e => {
  const open = $('#nav').classList.toggle('open');
  e.currentTarget.setAttribute('aria-expanded', open);
});
$$('#nav a').forEach(a => a.addEventListener('click', () => $('#nav').classList.remove('open')));

/* ---------- hero slider ---------- */
const slides = $$('.slide'); let cur = 0, timer;
const dotsBox = $('#dots');
slides.forEach((_, i) => {
  const b = document.createElement('button');
  b.className = 'dot' + (i === 0 ? ' on' : '');
  b.setAttribute('aria-label', 'Slide ' + (i + 1));
  b.onclick = () => { go(i); restart(); };
  dotsBox.appendChild(b);
});
function countUp(el){
  const to = +el.dataset.to, suf = el.dataset.suffix || '', t0 = performance.now(), dur = 1400;
  (function step(t){
    const p = Math.min(1, (t - t0) / dur);
    el.textContent = Math.round(to * (1 - Math.pow(1 - p, 3))) + (p === 1 ? suf : '');
    if (p < 1) requestAnimationFrame(step);
  })(t0);
}
function go(i){
  cur = (i + slides.length) % slides.length;
  slides.forEach((s, k) => s.classList.toggle('on', k === cur));
  $$('.dot').forEach((d, k) => d.classList.toggle('on', k === cur));
  $$('.count', slides[cur]).forEach(countUp);
}
function restart(){ clearInterval(timer); timer = setInterval(() => go(cur + 1), 7000); }
$('#prev').onclick = () => { go(cur - 1); restart(); };
$('#next').onclick = () => { go(cur + 1); restart(); };
$('.hero').addEventListener('mouseenter', () => clearInterval(timer));
$('.hero').addEventListener('mouseleave', restart);
restart();

/* ---------- modul ---------- */
const MODULES = [
  { id:'m1', icon:'🔋', title:'Apa itu kendaraan listrik?', time:'3 menit',
    sum:'Kenali istilah KBLBB dan jenis-jenis kendaraan listrik.',
    pts:[
      'Kendaraan Bermotor Listrik Berbasis Baterai (KBLBB) adalah kendaraan yang digerakkan motor listrik dengan tenaga dari baterai yang terpasang di kendaraan itu.',
      'BEV: sepenuhnya listrik, diisi dari sumber listrik luar. HEV: hibrida, mesin bensin dibantu motor listrik, tidak dicolok. PHEV: hibrida yang bisa dicolok. FCEV: memakai sel bahan bakar hidrogen untuk menghasilkan listrik.',
      'Tidak ada gas buang dari knalpot saat berjalan. Jejak emisi keseluruhan tetap bergantung pada cara listrik itu dibangkitkan.',
      'Pemerintah memandang KBLBB sebagai bagian transisi energi: mengurangi impor BBM dan subsidi BBM serta menekan emisi.'
    ],
    src:['Permen ESDM 13/2020','https://jdih.esdm.go.id/storage/document/PM%20ESDM%20No.%2013%20Tahun%202020.pdf'] },
  { id:'m2', icon:'⚙️', title:'Komponen utama', time:'4 menit',
    sum:'Baterai, BMS, controller, motor, dan charger: apa tugas masing-masing.',
    pts:[
      'Baterai menyimpan energi. BMS (battery management system) mengawasi tegangan, arus, dan suhu sel agar baterai aman dan awet.',
      'Controller (pada mobil sering disebut inverter) mengatur arus ke motor sesuai tarikan gas.',
      'Motor listrik mengubah energi listrik menjadi putaran. Jenis yang umum: BLDC dan PMSM. Pada sepeda listrik, motor BLDC banyak dipakai.',
      'Charger mengubah listrik AC dari jaringan menjadi DC untuk mengisi baterai.',
      'Transmisinya jauh lebih sederhana daripada mesin bakar karena torsi motor listrik sudah tersedia sejak putaran rendah.'
    ],
    src:['Jurnal Politap, sepeda listrik BLDC','https://jurnal.politap.ac.id/index.php/entries/article/download/1509/1110/8920'] },
  { id:'m3', icon:'🧪', title:'Baterai: kimia, kapasitas, perawatan', time:'4 menit',
    sum:'Perbedaan NMC dan LFP, serta cara menghitung kapasitas baterai.',
    pts:[
      'Kendaraan listrik modern umumnya memakai baterai lithium-ion. Dua kimia yang sering dibahas: NMC dan LFP.',
      'NMC: kerapatan energi lebih tinggi, jadi lebih ringan untuk jarak yang sama. LFP: umumnya lebih tahan banyak siklus pengisian dan lebih stabil terhadap panas, dengan kerapatan energi lebih rendah.',
      'Kapasitas energi (kWh) = tegangan (V) × kapasitas (Ah) ÷ 1000. Contoh: 72 V 20 Ah = 1,44 kWh.',
      'Baterai motor listrik berjenis LiNMC 72V 20Ah dan 72V 30Ah pernah diluncurkan dalam kerja sama produsen dalam negeri.',
      'Perawatan umum: hindari panas berlebih, jangan terlalu sering membiarkan baterai habis total, dan gunakan charger yang sesuai.'
    ],
    src:['Kontan, pengembangan motor listrik','https://industri.kontan.co.id/news/kementerian-esdm-gandeng-sejumlah-pihak-dorong-pengembangan-motor-listrik'] },
  { id:'m4', icon:'🔌', title:'Pengisian daya dan infrastruktur', time:'3 menit',
    sum:'SPKLU, SPBKLU, dan pengisian di rumah.',
    pts:[
      'SPKLU (Stasiun Pengisian Kendaraan Listrik Umum) menyediakan listrik untuk mengisi baterai kendaraan di tempat umum.',
      'SPBKLU (Stasiun Penukaran Baterai Kendaraan Listrik Umum) menyediakan baterai terisi untuk ditukar dengan baterai yang sudah habis, terutama untuk motor listrik.',
      'Home charging: mengisi di rumah, biasanya pada malam hari. Cocok untuk pemakaian harian jarak dekat.',
      'Pengisian AC lebih lambat dan lembut bagi baterai. Pengisian cepat DC lebih singkat waktunya, cocok untuk perjalanan jauh.',
      'PLN, Pertamina, dan Kementerian ESDM berkolaborasi membangun ekosistem ini. Hingga Mei 2022, PLN melaporkan 90 unit SPBKLU (data lama, jumlah terkini sudah berbeda).'
    ],
    src:['Listrik Indonesia, kolaborasi ESDM, PLN, Pertamina','https://listrikindonesia.com/detail/9799/kementerian-esdm-gandeng-pln-dan-pertamina-percepat-konversi-motor-bbm-ke-motor-listrik'] },
  { id:'m5', icon:'🏍️', title:'Konversi motor BBM ke listrik', time:'3 menit',
    sum:'Apa yang diganti, aturan apa yang berlaku, dan mengapa roda dua jadi sasaran.',
    pts:[
      'Konversi mengganti mesin bakar dan komponen bahan bakar dengan motor listrik, baterai, dan controller pada rangka motor yang sama.',
      'Konversi mengikuti Peraturan Menteri Perhubungan No. 65 Tahun 2020. Kementerian ESDM meluncurkan pilot 100 unit dengan 10 tipe motor pada 17 Agustus 2021.',
      'Pekerjaan konversi dilakukan di bengkel yang disertifikasi. ESDM juga rutin melatih bengkel dan guru SMK.',
      'Populasi kendaraan roda dua berbasis bensin disebut sekitar 120 juta unit dan tumbuh 5 sampai 6 persen per tahun (data ESDM, 2023), sehingga roda dua menjadi sasaran utama.',
      'Pada 2022, pemerintah menyebut target 6 juta motor listrik pada 2025 dan 13 juta pada 2030. Cek capaian terbaru di situs resmi ESDM.'
    ],
    src:['ESDM, sosialisasi kendaraan listrik','https://esdm.go.id/id/berita-unit/direktorat-jenderal-ketenagalistrikan/sosialisasikan-kendaraan-listrik-kementerian-esdm-dorong-partisipasi-pelaku-usaha'] },
  { id:'m6', icon:'🌏', title:'Dampak dan tren global', time:'4 menit',
    sum:'Angka terbaru dari IEA dan hal yang perlu dipertimbangkan.',
    pts:[
      'Penjualan mobil listrik dunia naik 20% pada 2025 dan melewati 20 juta unit, sekitar seperempat dari seluruh penjualan mobil baru.',
      'Produsen China memasok sekitar 60% mobil listrik dunia, sedangkan produsen Eropa dan Amerika Utara masing-masing sekitar 15%.',
      'IEA memproyeksikan 23 juta unit pada 2026 (sekitar 28% penjualan). Kuartal I 2026 sempat turun 8% akibat perubahan kebijakan di China dan AS, tetapi banyak negara tetap tumbuh.',
      'Di Asia Tenggara, penjualan EV lebih dari dua kali lipat pada 2025 dengan pangsa mendekati 20%, dan diproyeksikan bisa mencapai 60% pada 2035.',
      'Pertimbangan penting: sumber pembangkit listrik, daur ulang baterai, jaringan pengisian, dan harga.'
    ],
    src:['IEA, Global EV Outlook 2026','https://www.iea.org/reports/global-ev-outlook-2026'] }
];
let done = new Set(store.get('mv_done', []));
const modsBox = $('#mods');
function renderMods(){
  modsBox.innerHTML = MODULES.map(m => `
    <article class="mod ${done.has(m.id) ? 'done' : ''}" id="${m.id}">
      <div class="mod-head"><div class="ico" aria-hidden="true">${m.icon}</div>
        <div><h3>${m.title}</h3><div class="meta">Baca ${m.time}</div></div></div>
      <p class="sum">${m.sum}</p>
      <div class="body" id="b-${m.id}"><ul>${m.pts.map(p => `<li>${p}</li>`).join('')}</ul>
        <p class="src">Sumber: <a href="${m.src[1]}" target="_blank" rel="noopener">${m.src[0]}</a></p></div>
      <div class="mod-foot">
        <button class="btn-o" data-toggle="${m.id}" aria-expanded="false" aria-controls="b-${m.id}">Buka modul</button>
        <button class="btn-o ok ${done.has(m.id) ? 'on' : ''}" data-done="${m.id}">${done.has(m.id) ? '✓ Selesai' : 'Tandai selesai'}</button>
      </div>
    </article>`).join('');
  const n = done.size;
  $('#pText').textContent = n + ' / ' + MODULES.length + ' selesai';
  $('#pBar').style.width = (n / MODULES.length * 100) + '%';
}
function toggleMod(id, force){
  const el = $('#' + id); if (!el) return;
  const open = force ?? !el.classList.contains('open');
  el.classList.toggle('open', open);
  const b = $('[data-toggle]', el);
  b.textContent = open ? 'Tutup modul' : 'Buka modul';
  b.setAttribute('aria-expanded', open);
}
modsBox.addEventListener('click', e => {
  const t = e.target.closest('button'); if (!t) return;
  if (t.dataset.toggle) toggleMod(t.dataset.toggle);
  if (t.dataset.done){
    done.has(t.dataset.done) ? done.delete(t.dataset.done) : done.add(t.dataset.done);
    store.set('mv_done', [...done]);
    const openIds = $$('.mod.open').map(x => x.id);
    renderMods(); openIds.forEach(id => toggleMod(id, true));
  }
});
renderMods();
$$('[data-open]').forEach(a => a.addEventListener('click', () => setTimeout(() => toggleMod(a.dataset.open, true), 350)));

/* ---------- diagram ---------- */
const PARTS = [
  { k:'chg',  i:'🔌', n:'Charger', d:'Mengubah listrik AC dari jaringan (atau stasiun pengisian) menjadi DC dan mengisi baterai. Pada motor listrik, charger bisa terpasang di dalam atau di luar kendaraan.' },
  { k:'bat',  i:'🔋', n:'Baterai', d:'Menyimpan energi. Kapasitasnya dihitung dalam kWh (V × Ah ÷ 1000). Makin besar kapasitas, makin jauh jarak tempuh, tetapi makin berat dan mahal.' },
  { k:'bms',  i:'🧠', n:'BMS', d:'Battery Management System memantau tegangan, arus, dan suhu tiap sel, menyeimbangkan sel, dan memutus arus bila kondisi tidak aman.' },
  { k:'ctl',  i:'🎛️', n:'Controller', d:'Mengatur besar arus dan frekuensi ke motor sesuai tarikan gas. Saat mengerem, controller juga mengarahkan listrik hasil regenerasi kembali ke baterai.' },
  { k:'mot',  i:'🌀', n:'Motor', d:'Mengubah energi listrik menjadi putaran. Saat pengereman regeneratif, motor berperan sebagai generator dan menghasilkan listrik dari gerak roda.' },
  { k:'whl',  i:'🛞', n:'Roda', d:'Menerima putaran dari motor melalui transmisi sederhana. Pada motor listrik tertentu, motor terpasang langsung di hub roda.' }
];
const flow = $('#flow'), info = $('#info');
function showPart(k){
  const p = PARTS.find(x => x.k === k);
  $$('.node', flow).forEach(n => n.classList.toggle('on', n.dataset.k === k));
  info.innerHTML = `<h4>${p.i} ${p.n}</h4><p>${p.d}</p>`;
}
flow.innerHTML = PARTS.map((p, i) =>
  `<button class="node" data-k="${p.k}"><span aria-hidden="true">${p.i}</span>${p.n}</button>` +
  (i < PARTS.length - 1 ? '<div class="link" aria-hidden="true"></div>' : '')).join('');
flow.addEventListener('click', e => { const n = e.target.closest('.node'); if (n) showPart(n.dataset.k); });
$$('.tog button').forEach(b => b.addEventListener('click', () => {
  $$('.tog button').forEach(x => x.classList.toggle('on', x === b));
  const regen = b.dataset.mode === 'regen';
  $('#diag').classList.toggle('regen', regen);
  info.innerHTML = regen
    ? '<h4>Mode mengerem</h4><p>Saat pengereman regeneratif, aliran energi berbalik: roda memutar motor yang bekerja sebagai generator, controller menyalurkan listrik ke baterai. Sebagian energi gerak pun dipulihkan, bukan terbuang sebagai panas.</p>'
    : '<h4>Mode berjalan</h4><p>Energi mengalir dari baterai lewat controller ke motor, lalu menggerakkan roda. Klik komponen mana pun untuk detailnya.</p>';
  if (!regen) showPart('mot');
}));
showPart('bat');

/* ---------- kalkulator ---------- */
const ids = ['v','ah','use','wh','chg','tar','kmL','fuel'];
const num = id => Math.max(0, parseFloat($('#' + id).value) || 0);
const rp = n => 'Rp' + Math.round(n).toLocaleString('id-ID');
function calc(){
  const E = num('v') * num('ah') / 1000;
  const usable = E * num('use') / 100;
  const km = num('wh') ? usable * 1000 / num('wh') : 0;
  const hours = num('chg') ? E * 1000 / num('chg') : 0;
  const costE = num('wh') * 100 / 1000 * num('tar');
  const costF = num('kmL') ? 100 / num('kmL') * num('fuel') : 0;
  $('#rE').textContent = E.toFixed(2).replace('.', ',') + ' kWh';
  $('#rR').textContent = Math.round(km) + ' km';
  $('#rT').textContent = hours.toFixed(1).replace('.', ',') + ' jam';
  $('#rC').textContent = rp(costE);
  $('#rF').textContent = rp(costF);
}
ids.forEach(id => $('#' + id).addEventListener('input', calc));
calc();

/* ---------- kuis ---------- */
const QUIZ = [
  { q:'Apa kepanjangan KBLBB?', o:['Kendaraan Bermotor Listrik Berbasis Baterai','Kendaraan Bensin Listrik Berbahan Baterai','Kendaraan Berbasis Lithium dan Baterai Bekas','Kendaraan Bermotor Listrik Bertenaga Bensin'], a:0, e:'KBLBB adalah kendaraan yang digerakkan motor listrik dengan tenaga dari baterai di kendaraan itu.' },
  { q:'Komponen mana yang mengawasi suhu dan tegangan sel baterai?', o:['Charger','BMS','Roda','Knalpot'], a:1, e:'BMS memantau dan melindungi sel baterai agar bekerja aman.' },
  { q:'Berapa kapasitas energi baterai 72 V 20 Ah?', o:['0,72 kWh','1,44 kWh','14,4 kWh','7,2 kWh'], a:1, e:'72 × 20 ÷ 1000 = 1,44 kWh.' },
  { q:'Apa fungsi SPBKLU?', o:['Mengisi bensin motor listrik','Menukar baterai habis dengan baterai terisi','Menyimpan baterai bekas selamanya','Memperbaiki rangka motor'], a:1, e:'SPBKLU adalah stasiun penukaran baterai kendaraan listrik umum.' },
  { q:'Apa yang terjadi saat pengereman regeneratif?', o:['Motor berhenti bekerja dan energi terbuang','Motor berperan sebagai generator dan mengisi baterai','Baterai dikosongkan','Mesin bensin menyala'], a:1, e:'Energi gerak diubah kembali menjadi listrik dan dikirim ke baterai.' },
  { q:'Menurut IEA, kira-kira berapa penjualan mobil listrik dunia pada 2025?', o:['Kurang dari 1 juta','Sekitar 5 juta','Lebih dari 20 juta','Lebih dari 200 juta'], a:2, e:'IEA mencatat penjualan naik 20% dan melampaui 20 juta unit pada 2025.' }
];
let qi = 0, score = 0, answered = false;
const quizBox = $('#quiz');
function renderQ(){
  if (qi >= QUIZ.length){
    quizBox.innerHTML = `<div class="q"><h3>Skor kamu: ${score} dari ${QUIZ.length}</h3>
      <p class="fb">${score >= 5 ? 'Bagus sekali, pemahamanmu sudah kuat.' : score >= 3 ? 'Cukup baik. Buka lagi modul yang terasa kurang, lalu coba lagi.' : 'Tidak apa-apa. Baca ulang modulnya, lalu coba kuis lagi.'}</p>
      <button class="btn" id="again">Ulangi kuis</button></div>`;
    $('#again').onclick = () => { qi = 0; score = 0; renderQ(); };
    return;
  }
  const q = QUIZ[qi]; answered = false;
  quizBox.innerHTML = `<div class="q"><div class="meta">Pertanyaan ${qi + 1} dari ${QUIZ.length}</div>
    <h3>${q.q}</h3>
    ${q.o.map((t, i) => `<button class="opt" data-i="${i}">${t}</button>`).join('')}
    <p class="fb" id="fb" aria-live="polite"></p>
    <div class="qnav"><span class="meta">Skor sementara: ${score}</span><button class="btn sm" id="nx" style="visibility:hidden">${qi === QUIZ.length - 1 ? 'Lihat skor' : 'Lanjut'}</button></div></div>`;
  $$('.opt', quizBox).forEach(b => b.onclick = () => {
    if (answered) return; answered = true;
    const i = +b.dataset.i, ok = i === q.a; if (ok) score++;
    $$('.opt', quizBox).forEach((x, k) => { x.disabled = true; if (k === q.a) x.classList.add('right'); });
    if (!ok) b.classList.add('wrong');
    $('#fb').textContent = (ok ? 'Benar. ' : 'Belum tepat. ') + q.e;
    $('#nx').style.visibility = 'visible';
  });
  $('#nx').onclick = () => { qi++; renderQ(); };
}
renderQ();

/* highlight menu sesuai bagian yang terlihat */
const secs = ['top','modul','diagram','kalkulator','kuis','referensi'];
addEventListener('scroll', () => {
  let c = 'top';
  secs.forEach(id => { const el = document.getElementById(id); if (el && el.getBoundingClientRect().top < 140) c = id; });
  $$('#nav a').forEach(a => a.classList.toggle('on', a.getAttribute('href') === '#' + c));
}, { passive:true });

/* animasi hitung pada slide pertama bila ada */
go(10);
</script>
</body>
</html>
